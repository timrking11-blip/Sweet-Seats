# Public web client: only the Supabase URL and anon key may be exposed to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never commit real values.
SWEET_SEATS_API_ORIGIN=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=
TICKETMASTER_API_KEY=
# Live Discovery calls stay off unless this is true AND an approved SourcePermission exists.
SWEET_SEATS_TICKETMASTER_ENABLED=false
RESEND_API_KEY=
# Reserved for later, approved internal-research activation only.
PERPLEXITY_API_KEY=
LINEAR_API_KEY=



# Local synthetic PostgreSQL only. Explicitly selects Postgres instead of legacy JSON.
SWEET_SEATS_LOCAL_DATABASE_URL=
# Disposable test admin database (CREATE/DROP DATABASE required); never a shared DB.
SWEET_SEATS_TEST_DATABASE_URL=
