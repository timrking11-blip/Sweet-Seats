{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Sweet Seats tokens in DTCG format. This is the single source of truth. Run pnpm tokens to regenerate web and portable outputs. Midnight Session dark values are copied from the approved shared brand foundation and SS-BRAND-UI-1.1. Light values are an accessible derived companion, not an owner-approved product theme.",
  "color": {
    "$type": "color",
    "light": {
      "$description": "Derived light companion for preview only; the supplied specification defines Midnight Session as the canonical dark palette. Review before applying to product screens.",
      "background": { "$value": "#FFF1DD" },
      "foreground": { "$value": "#031126" },
      "border": { "$value": "#72849A" },
      "card": { "$value": "#FFF8EE" },
      "cardForeground": { "$value": "#031126" },
      "popover": { "$value": "#FFF8EE" },
      "popoverForeground": { "$value": "#031126" },
      "primary": {
        "$value": "#FF624D",
        "$description": "Canonical coral; navy foreground maintains the approved dark palette contrast."
      },
      "primaryForeground": { "$value": "#031126" },
      "secondary": { "$value": "#E6ECE9" },
      "secondaryForeground": { "$value": "#031126" },
      "muted": { "$value": "#F2E9DC" },
      "mutedForeground": { "$value": "#31445A" },
      "accent": {
        "$value": "#17695F",
        "$description": "Teal darkened from the canonical accent so links and controls remain legible on warm cream."
      },
      "accentForeground": { "$value": "#FFF1DD" },
      "destructive": {
        "$value": "#A9433A",
        "$description": "Error hue darkened for a readable light-mode action; this role is derived."
      },
      "destructiveForeground": { "$value": "#FFF1DD" },
      "input": { "$value": "#72849A" },
      "ring": { "$value": "#13685F" },
      "chart1": { "$value": "#C94C3F" },
      "chart2": { "$value": "#17695F" },
      "chart3": { "$value": "#8A5B00" },
      "chart4": { "$value": "#28734F" },
      "chart5": { "$value": "#A9433A" },
      "sidebar": { "$value": "#FFF8EE" },
      "sidebarForeground": { "$value": "#031126" },
      "sidebarBorder": { "$value": "#72849A" },
      "sidebarPrimary": { "$value": "#FF624D" },
      "sidebarPrimaryForeground": { "$value": "#031126" },
      "sidebarAccent": { "$value": "#E6ECE9" },
      "sidebarAccentForeground": { "$value": "#031126" },
      "sidebarRing": { "$value": "#13685F" }
    },
    "dark": {
      "$description": "Canonical Midnight Session theme from lib/sweet-seats-brand/tokens.css and SS-BRAND-UI-1.1.",
      "background": { "$value": "#031126" },
      "foreground": { "$value": "#FFF1DD" },
      "border": { "$value": "#2A3E56" },
      "card": { "$value": "#0D2038" },
      "cardForeground": { "$value": "#FFF1DD" },
      "popover": { "$value": "#162D47" },
      "popoverForeground": { "$value": "#FFF1DD" },
      "primary": { "$value": "#FF624D" },
      "primaryForeground": { "$value": "#031126" },
      "secondary": { "$value": "#162D47" },
      "secondaryForeground": { "$value": "#FFF1DD" },
      "muted": { "$value": "#0D2038" },
      "mutedForeground": { "$value": "#B7C3D1" },
      "accent": { "$value": "#67BCAF" },
      "accentForeground": { "$value": "#031126" },
      "destructive": { "$value": "#FFB1A8" },
      "destructiveForeground": { "$value": "#031126" },
      "input": { "$value": "#72849A" },
      "ring": { "$value": "#67BCAF" },
      "chart1": { "$value": "#FF624D" },
      "chart2": { "$value": "#67BCAF" },
      "chart3": { "$value": "#F1CC77" },
      "chart4": { "$value": "#91D4AA" },
      "chart5": { "$value": "#FFB1A8" },
      "sidebar": { "$value": "#031126" },
      "sidebarForeground": { "$value": "#FFF1DD" },
      "sidebarBorder": { "$value": "#2A3E56" },
      "sidebarPrimary": { "$value": "#FF624D" },
      "sidebarPrimaryForeground": { "$value": "#031126" },
      "sidebarAccent": { "$value": "#162D47" },
      "sidebarAccentForeground": { "$value": "#FFF1DD" },
      "sidebarRing": { "$value": "#67BCAF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
        "$description": "System stack only; no remote or licensed font is required."
      },
      "serif": {
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
        "$description": "Schema fallback aliases the sans stack; the Sweet Seats interface does not use serif display type."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"],
        "$description": "Platform-provided code and data fallback."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "12px",
      "$description": "Control radius; Tailwind-derived xl is 16px for independent cards and dialogs."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "4px",
      "$description": "Four-pixel base unit; the documented scale includes 4, 8, 12, 16, 24, 32, 48, 64, and 96px."
    }
  }
}
